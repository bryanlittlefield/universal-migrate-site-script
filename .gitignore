# Local configuration (contains credentials) — never commit
.env
.env.*
!.env.example

# Run artefacts
logs/*
!logs/.gitkeep
dumps/*
!dumps/.gitkeep
*.sql
*.sql.gz
*.log
# ...but test fixtures must be tracked
!tests/fixtures/*.sql

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# GUI: per-migration env files and hook scripts (credentials, local commands)
sites/*
!sites/.gitkeep
hooks/*
!hooks/.gitkeep
__pycache__/
