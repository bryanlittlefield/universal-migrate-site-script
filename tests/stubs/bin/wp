#!/usr/bin/env bash
printf 'wp %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
[[ -n ${WP_CONFIG_PATH:-} ]] && printf 'wp-env WP_CONFIG_PATH=%s\n' "$WP_CONFIG_PATH" >> "${STUB_LOG:-/dev/null}"
# Like WP_CLI_STRICT_ARGS_MODE: a global flag after the command is an error.
seen_cmd=false
for a in "$@"; do
  case $a in
    --quiet|--url=*|--path=*|--allow-root|--skip-plugins|--skip-themes)
      if [[ $seen_cmd == true ]]; then printf 'Error: Parameter errors:\n unknown %s parameter\n' "${a%%=*}" >&2; exit 1; fi ;;
    -*) ;;
    *) seen_cmd=true ;;
  esac
done
args=" $* "
case "$args" in
  *" core is-installed --network "*) exit "${STUB_WP_MULTISITE_EXIT:-1}" ;;
  *" core version "*) echo "6.6.2" ;;
  *" option get home "*|*" option get siteurl "*) echo "http://${STUB_WP_HOME_DOMAIN:-site.local}" ;;
  *" config get DOMAIN_CURRENT_SITE "*) echo "${STUB_DOMAIN_CURRENT_SITE:-old.example.com}" ;;
  *" plugin is-installed "*)
    p=${args##* plugin is-installed }; p=${p%% *}
    [[ ",${STUB_WP_INSTALLED_PLUGINS:-}," == *",${p},"* ]] && exit 0
    exit 1 ;;
  *" cli has-command "*) exit 1 ;;
  *" user get "*) exit 1 ;;
  *" db check "*) echo ok ;;
esac
exit 0
