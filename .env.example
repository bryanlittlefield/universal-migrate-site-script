# universal-migrate-site-script configuration
# Copy to .env and fill in. .env is git-ignored. Quote values with single quotes
# so special characters survive. Variable names match the original
# migrate-site-script, so an old .env also works (see README "Upgrading").

# ---------------------------------------------------------------- Remote server (source)
remote_ssh_host=''                 # IP or hostname
remote_ssh_user=''
remote_ssh_port='22'
remote_ssh_key=''                  # path to a private key (recommended). Leave empty to use ssh-agent or a password
remote_ssh_pass=''                 # only if no key; needs `sshpass` installed
remote_ssh_web_root=''             # absolute path, e.g. /var/www/html
remote_domain=''                   # e.g. www.example.com (scheme optional)
remote_scheme='https'              # scheme the remote site uses: http | https
ssh_strict_host_key='accept-new'   # accept-new (default) | yes | no

# ---------------------------------------------------------------- Remote database
export_db_name=''
export_db_user=''
export_db_pass=''
export_db_host='127.0.0.1'         # as seen FROM the remote server (127.0.0.1 = same box; or an external DB host)
export_db_port='3306'
db_export_method='tunnel'          # tunnel: dump through an SSH tunnel using the local mysqldump
                                   # remote: run mysqldump on the remote server and stream it back (no temp files there)
export_db_filename=''              # optional; default dumps/<export_db_name>-<timestamp>.sql
export_db_ssl_flag=''              # optional override for the remote dump client, e.g. --skip-ssl or --ssl-mode=DISABLED
db_transfer_compress='auto'        # remote method only: gzip the stream (auto | true | false)
mysqldump_extra_opts=''            # e.g. '--routines --events'

# ---------------------------------------------------------------- Local server (destination)
local_web_root=''                  # absolute path, e.g. /var/www/html
local_domain=''                    # e.g. example.local
local_scheme='https'               # http | https
import_db_name=''
import_db_user=''
import_db_pass=''
import_db_host='127.0.0.1'
import_db_port='3306'
import_db_ssl_flag=''              # optional override for the local client
create_local_db='true'             # create import_db_name if it does not exist
local_db_backup='true'             # back up the existing local DB before dropping it
local_db_backup_filename=''        # optional; default dumps/<import_db_name>-backup-<timestamp>.sql.gz
db_fix_collation='auto'            # map MySQL 8 utf8mb4_0900_* collations for MariaDB / MySQL < 8 (auto | true | false)
db_preserve_tables=''              # local tables whose DATA survives the import, e.g. 'wp_options' or '*_options wp_users'
                                   # (saved before the drop, restored after; only their structure is taken from the remote)
keep_dump='true'                   # keep the downloaded dump after a successful import

# ---------------------------------------------------------------- Platform
platform='auto'                    # wordpress | laravel | auto (detects from wp-config.php / artisan)
uploads_rel_path=''                # relative uploads dir; default wp-content/uploads or storage/app/public

# ---------------------------------------------------------------- File sync
sync_mode='full'                   # full | code (everything except uploads) | uploads (only uploads)
rsync_mode='sync'                  # sync (update changed files) | ignore-existing (only new files) | mirror (also delete local extras)
rsync_bwlimit=''                   # e.g. 5000 (KB/s)
rsync_extra_opts=''                # appended verbatim, e.g. '--chmod=D755,F644'
rsync_exclude_file_path='config/rsync-exclude.txt'
replace_www_variant='true'         # also replace www.<remote_domain> -> local_domain
domain_pairs_file_path='config/domain-pairs.txt'

# ---------------------------------------------------------------- Database lists
db_exclude_tables_file_path='config/db-tables-exclude.txt'
wp_search_replace_exclude_file_path='config/wp-search-replace-exclude.txt'

# ---------------------------------------------------------------- WordPress local settings
wp_environment_type='local'        # WP_ENVIRONMENT_TYPE; empty = leave alone
wp_debug='true'                    # WP_DEBUG
wp_discourage_search_engines='true' # blog_public=0
wp_remove_dropins='true'           # delete object-cache.php / advanced-cache.php drop-ins
wp_cli_extra_opts=''               # e.g. '--skip-plugins --skip-themes'
host_mu_plugins_file_path='config/host-mu-plugins.txt'
host_plugins_deactivate_file_path='config/host-plugins-deactivate.txt'
wpe_config_patterns_file_path='config/wpe-config-patterns.txt'
wp_local_admin_user=''             # optional: create/update a local administrator
wp_local_admin_pass=''
wp_local_admin_email=''            # default <user>@<local_domain>

# ---------------------------------------------------------------- Laravel local settings
laravel_app_env='local'
laravel_app_debug='true'

# ---------------------------------------------------------------- Kinsta (only when migrating TO Kinsta)
kinsta_mu_plugins_url='https://kinsta.com/kinsta-tools/kinsta-mu-plugins.zip'
kinsta_force_reinstall='false'

# ---------------------------------------------------------------- Behaviour
auto_confirm='false'               # true = same as --yes
continue_on_error='false'          # keep running later steps after one fails
plain_output='false'               # true = same as --plain (no colours/emoji)
log_dir='logs'
dump_dir='dumps'
preflight_disk_check='false'       # compare remote size with local free space before syncing (slow on big sites)
verify_http='true'                 # curl the local domain in the verify step
verify_db_check='false'            # run `wp db check` in the verify step

# ---------------------------------------------------------------- Steps
# Normal steps run unless skipped. Opt-in steps (clear-web-root, kinsta-plugins)
# only run when you say so: run_<step>=true here, or --with <step> on the CLI.
skip_migrate_website='false'       # true = exit immediately (for wrapper scripts)
skip_clear_web_root='false'
skip_maintenance='false'
skip_file_sync='false'
skip_db_import='false'
skip_app_config='false'
skip_host_cleanup='false'
skip_kinsta_plugins='false'
skip_local_hardening='false'
skip_cache_refresh='false'
skip_verify='false'
run_clear_web_root='false'
run_kinsta_plugins='false'
